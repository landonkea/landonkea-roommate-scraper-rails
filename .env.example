# Copy this file to .env and fill in real values. .env itself is
# git-ignored (see .gitignore) so your real webhook URL never gets
# committed to GitHub -- only this .env.example template (with no real
# secrets in it) is tracked.

# The Discord webhook URL that new/good listings get posted to. Get this
# from Discord: Server Settings -> Integrations -> Webhooks -> New
# Webhook -> Copy Webhook URL. Leave this unset and the scraper will
# still run fine, it'll just log listings instead of posting to Discord.
DISCORD_WEBHOOK_URL=

# Optional: full path to a Chrome/Chromium binary, only needed if Ferrum
# (the headless-browser gem used for PadSplit/SpareRoom/etc.) can't find
# one on its own. The Docker image sets this automatically -- you'd only
# set it locally if you have Chrome installed somewhere non-standard.
BROWSER_PATH=

